<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout"
         xmlns:t="/lib/hudson" xmlns:f="/lib/form">
  <f:section title="Throttle Concurrent Builds">
    <f:entry title="Multi-Project Throttle Categories" field="categories">
      <f:repeatable field="categories" add="${%Add Category}" minimum="0">
        <f:entry title="Category Name" field="categoryName">
          <f:textbox clazz="required" checkMessage="${%Category Name is required}"/>
        </f:entry>
        <f:entry title="${%Maximum Total Concurrent Builds}" field="maxConcurrentTotal">
          <f:number min="0"/>
        </f:entry>
        <f:entry title="${%Maximum Concurrent Builds Per Node}" field="maxConcurrentPerNode">
          <f:number min="0"/>
        </f:entry>
        <f:repeatable field="nodeLabeledPairs" add="${%Add Maximum Per Labeled Node}" minimum="0" header="${%Maximum Per Labeled Node}">
          <f:entry title="${%Throttled Node Label}" field="throttledNodeLabel">
            <f:textbox />
          </f:entry>
          <f:entry title="${%Maximum Concurrent Builds Per Node Labeled As Above}" field="maxConcurrentPerNodeLabeled">
            <f:number min="0"/>
          </f:entry>
          <f:repeatableDeleteButton/>
        </f:repeatable>
        <f:repeatableDeleteButton/>
      </f:repeatable>
    </f:entry>

    <f:advanced>
      <f:section title="${%Shared Hardware Throttling}">
        <j:set var="sw" value="${descriptor.sharedHardwareThrottle}"/>
        <f:entry title="${%Label Key for Machine Assignment}" field="labelKey">
          <f:textbox value="${sw.labelKey}" default="THROTTLE_SHARED_HARDWARE"/>
        </f:entry>
        <f:entry title="${%Label Key for Machine Max Capacity}" field="maxLabelKey">
          <f:textbox value="${sw.maxLabelKey}" default="THROTTLE_SHARED_HARDWARE_MAX"/>
        </f:entry>
        <f:entry title="${%Machine Capacities}">
          <f:repeatable var="instance" name="machineCapacities" items="${sw.machineCapacities}" add="${%Add Machine}" minimum="0">
            <f:entry title="${%Machine Name}" field="machineName">
              <f:textbox clazz="required" checkMessage="${%Machine Name is required}"/>
            </f:entry>
            <f:entry title="${%Max Total Weight}" field="maxWeight">
              <f:number min="1"/>
            </f:entry>
            <f:repeatableDeleteButton/>
          </f:repeatable>
        </f:entry>
        <f:entry title="${%Fallback Capacity Factor}" field="fallbackCapacityFactor">
          <f:number value="${sw.fallbackCapacityFactor}" default="0" min="0"/>
        </f:entry>
      </f:section>
    </f:advanced>
  </f:section>
</j:jelly>
